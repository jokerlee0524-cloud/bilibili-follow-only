{
  "manifest_version": 3,
  "name": "B站 · 只看关注",
  "version": "1.1.0",
  "key": "",
  "description": "把 B 站首页变成只属于你关注 UP 主的视频流，屏蔽非关注推荐；可一键切到「只看特别关注」。",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://www.bilibili.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "B站 · 只看关注",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://bilibili.com/*"
      ],
      "js": [
        "md5.js",
        "wbi.js",
        "feed.js"
      ],
      "css": [
        "feed.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
